doi: "10.5281/zenodo.22215864"
version: "2.0.0"
date-released: "2026-09-26"
url: "https://fborrasumh.github.io/refinia/"
repository-code: "https://github.com/fborrasumh/refinia"
license: MIT
keywords:
  - "revisión de manuscritos"
  - "integridad científica"
  - "statcheck"
  - "verificación de referencias"
  - "OpenAlex"
  - "inteligencia artificial"
